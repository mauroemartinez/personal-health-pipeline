# Copy to .env (ignored by Git) and fill locally. Never commit real values.

# Local UTC offset (e.g. +01:00) used for records without their own timezone field.
HEALTH_UTC_OFFSET=+00:00

# --- Supabase project that hosts schema `health` ---
# Project ref = the id in https://<ref>.supabase.co. The loader refuses to write
# if HEALTH_DATABASE_URL does not point to that project (host or pooler user).
HEALTH_SUPABASE_PROJECT_REF=
# Postgres URL for the least-privilege `health_loader` role
# (see supabase/migrations/0001_health_schema.sql), not the postgres superuser.
HEALTH_DATABASE_URL=

# Optional personal context added to the digest for the LLM (routine, goals).
HEALTH_DIGEST_CONTEXT=

# Supabase personal access token, only for scripts/deploy_connector.py. Revoke after deploying.
SUPABASE_ACCESS_TOKEN=

# Optional: shade the first N days of history in the dashboard while the band calibrates (e.g. 4).
HEALTH_CALIBRATION_DAYS=

# Optional: your height in cm, to draw a healthy-weight band (BMI 18.5-24.9) in the dashboard.
HEALTH_HEIGHT_CM=
